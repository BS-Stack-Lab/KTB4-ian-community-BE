[Unit]
Description=Ian Community backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ian-community
Group=ian-community
WorkingDirectory=/opt/ian-community
Environment=SPRING_PROFILES_ACTIVE=prod
EnvironmentFile=/etc/ian-community/backend.env
ExecStart=/usr/bin/java -jar /opt/ian-community/backend.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ian-community

[Install]
WantedBy=multi-user.target
