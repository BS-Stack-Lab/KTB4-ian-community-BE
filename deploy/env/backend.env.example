# Copy this file to /etc/ian-community/backend.env on the EC2 instance.
# Keep the real file readable only by root and never commit its values.

JWT_SECRET=
FRONTEND_ORIGIN=https://community.example.com
APP_DATA_PATH=/var/lib/ian-community/data
LOCAL_STORAGE_PATH=/var/lib/ian-community/storage/images
H2_DATABASE_USERNAME=sa
H2_DATABASE_PASSWORD=
