# Commit-addressed application images; never use latest.
FRONTEND_IMAGE=community-frontend:<frontend-commit-sha>
BACKEND_IMAGE=community-backend:<backend-commit-sha>

# MySQL 8.4 LTS is required by the migration collation.
MYSQL_IMAGE=mysql:8.4.7
MYSQL_DATABASE=community
DB_USERNAME=community

# EC2 bind mounts and root-owned secret files.
DATA_ROOT=/data/community
SECRETS_DIR=/etc/community/secrets

# Use the exact browser origin, without a trailing slash.
FRONTEND_ORIGIN=http://<ec2-public-ip-or-domain>
COOKIE_SECURE=false
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

# Initial t3a.small tuning; revise after checking docker stats and OOM events.
DB_POOL_MAX_SIZE=8
DB_POOL_MIN_IDLE=1
JAVA_TOOL_OPTIONS=-Xms256m -Xmx640m -XX:+ExitOnOutOfMemoryError
