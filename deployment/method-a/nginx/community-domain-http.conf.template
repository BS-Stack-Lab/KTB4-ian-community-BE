server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __COMMUNITY_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    include /etc/nginx/snippets/community-app.conf;
}
