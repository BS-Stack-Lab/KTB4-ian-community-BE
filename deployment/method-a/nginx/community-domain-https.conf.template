server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __COMMUNITY_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://__COMMUNITY_DOMAIN__$request_uri;
    }
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name __COMMUNITY_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__COMMUNITY_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__COMMUNITY_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:CommunityTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/snippets/community-app.conf;
}
